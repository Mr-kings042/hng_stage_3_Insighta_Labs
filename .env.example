################################################################################
# INSIGHTA LABS - ENVIRONMENT CONFIGURATION
################################################################################
#
# Copy this file to .env and fill in your values
# CRITICAL: Add .env to .gitignore - NEVER commit secrets to version control!
#
# For detailed setup instructions, see GITHUB_OAUTH_SETUP.md

################################################################################
# DATABASE CONFIGURATION
################################################################################

# SQLite (Development - Default)
DATABASE_URL=sqlite:///./profiles.db

# PostgreSQL (Production)
# Uncomment for production deployment
# DATABASE_URL=postgresql://username:password@localhost:5432/insighta_db
# Example: postgresql://insighta:secure_password@db.example.com:5432/insighta_prod

################################################################################
# GITHUB OAUTH 2.0 CONFIGURATION
################################################################################
#
# SETUP INSTRUCTIONS:
# 1. Go to https://github.com/settings/developers
# 2. Click "OAuth Apps" → "New OAuth App"
# 3. Fill in application details:
#    - Application name: Insighta Labs
#    - Homepage URL: http://localhost:3000
#    - Authorization callback URL: http://localhost:8000/auth/github/callback
# 4. Copy the generated Client ID and Secret below
#
# SECURITY: Never commit actual credentials to version control!
# Use a secure secret management system (AWS Secrets Manager, HashiCorp Vault, etc)

# GitHub OAuth Client ID
# Format: 20-character alphanumeric string
# Safe to share (not sensitive)
GITHUB_CLIENT_ID=your_github_client_id_here

# GitHub OAuth Client Secret
# Format: Long secure string
# ⚠️  SENSITIVE - Treat like a password
# ⚠️  If accidentally exposed, regenerate at GitHub settings
# Regenerate: https://github.com/settings/developers → OAuth App → Regenerate
GITHUB_CLIENT_SECRET=your_github_client_secret_here

################################################################################
# BACKEND URL CONFIGURATION
################################################################################
#
# Used by OAuth callback - must match GitHub app settings exactly
# Development: http://localhost:8000
# Staging: https://staging-api.insighta-labs.com
# Production: https://api.insighta-labs.com
#
# IMPORTANT: Update GitHub OAuth app if you change this URL
#            (Settings → Authorization callback URLs)

BACKEND_URL=http://localhost:8000

################################################################################
# JWT CONFIGURATION
################################################################################
#
# Token signing and verification

# JWT Secret Key (used to sign/verify tokens)
# Generate new: openssl rand -hex 32
# CRITICAL: Use strong random value, never the example below!
# 
# Generate securely:
#   macOS/Linux:  openssl rand -hex 32
#   Python:       import secrets; secrets.token_hex(32)
#   Node.js:      require('crypto').randomBytes(32).toString('hex')
JWT_SECRET_KEY=your-secret-key-change-in-production-generate-with-openssl-rand-hex-32

# JWT Algorithm
# Options: HS256, HS384, HS512, RS256, RS384, RS512, ES256, ES384, ES512
# Recommended: HS256 (HMAC with SHA-256)
JWT_ALGORITHM=HS256

################################################################################
# TOKEN EXPIRY CONFIGURATION
################################################################################
#
# Token lifetimes in seconds
# Recommended: Access short-lived (3 min), Refresh medium-lived (5 min)

# Access Token Expiry
# Short-lived token used for API requests
# Recommended: 180 seconds (3 minutes) - balances security & user experience
ACCESS_TOKEN_EXPIRY=180

# Refresh Token Expiry
# Medium-lived token used to obtain new access tokens
# Recommended: 300 seconds (5 minutes) - slightly longer than access token
REFRESH_TOKEN_EXPIRY=300

################################################################################
# RATE LIMITING CONFIGURATION
################################################################################
#
# Maximum requests per minute (per IP for auth, per user for others)
# Prevents brute force and abuse

# Auth Endpoints Rate Limit (login, token refresh)
# Requests per minute per IP
# Recommended: 10 (allows ~1 attempt per 6 seconds)
RATE_LIMIT_AUTH=10

# General Endpoints Rate Limit (list, search, export)
# Requests per minute per authenticated user
# Recommended: 60 (allows continuous normal usage)
RATE_LIMIT_GENERAL=60

# Set TESTING=1 to disable rate limiting (for integration tests)
# TESTING=1

################################################################################
# ENVIRONMENT & DEBUG CONFIGURATION
################################################################################

# Environment
# Options: development, staging, production
# Affects logging, error messages, performance optimizations
ENVIRONMENT=development

# Debug Mode
# Options: True (development), False (production)
# Enables detailed error messages and stack traces
# NEVER use True in production (leaks sensitive information)
DEBUG=True

################################################################################
# RECOMMENDED ENVIRONMENT OVERRIDES
################################################################################

# For Production Deployment:
# ────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://prod_user:secure_password@prod-db.example.com/insighta_prod
# GITHUB_CLIENT_ID=prod_client_id_20_chars
# GITHUB_CLIENT_SECRET=prod_secret_very_long_secure_string
# BACKEND_URL=https://api.insighta-labs.com
# JWT_SECRET_KEY=<generate-securely-with-openssl-rand-hex-32>
# ENVIRONMENT=production
# DEBUG=False
# RATE_LIMIT_AUTH=5
# RATE_LIMIT_GENERAL=30

# For Staging Deployment:
# ────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://staging_user:password@staging-db/insighta_staging
# GITHUB_CLIENT_ID=staging_client_id
# GITHUB_CLIENT_SECRET=staging_secret
# BACKEND_URL=https://staging-api.insighta-labs.com
# ENVIRONMENT=staging
# DEBUG=False
